{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lunar",
  "scopeName": "source.lunar",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#members"
    },
    {
      "include": "#locals"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lunar",
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]"
        },
        {
          "name": "comment.line.double-dash.lunar",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lunar",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.lunar",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.other.multiline.lunar",
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]"
        },
        {
          "name": "string.template.lunar",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "name": "meta.template.expression.lunar",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.lunar"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.lunar"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.lunar",
      "match": "\\\\(\\d{1,3}|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|z|.)"
    },
    "numbers": {
      "name": "constant.numeric.lunar",
      "match": "\\b0[xX][0-9A-Fa-f]*(\\.[0-9A-Fa-f]*)?([pP][+-]?\\d+)?\\b|(\\b\\d+(\\.\\d*)?|\\.\\d+)([eE][+-]?\\d+)?\\b"
    },
    "decorators": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.decorator.lunar"
        },
        "2": {
          "name": "entity.name.function.decorator.lunar"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|interface|enum|type|namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*($|<|=|extends\\b|implements\\b|--))",
          "captures": {
            "1": {
              "name": "storage.type.lunar"
            },
            "2": {
              "name": "entity.name.type.lunar"
            }
          }
        },
        {
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_.:]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.lunar"
            },
            "2": {
              "name": "entity.name.function.lunar"
            }
          }
        },
        {
          "match": "\\b(extends|implements)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.lunar"
            },
            "2": {
              "name": "entity.other.inherited-class.lunar"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lunar",
          "match": "\\b(if|then|else|elseif|end|for|while|do|repeat|until|break|return|in|goto)\\b"
        },
        {
          "name": "keyword.control.lunar",
          "match": "\\bmatch\\b(?=\\s+.*\\bwith\\b)|\\bwith\\s*$|\\bwhen\\b(?!\\s*[=.:(\\[])"
        },
        {
          "name": "keyword.control.import.lunar",
          "match": "^\\s*(import|export|declare)\\b|\\bfrom\\b(?=\\s*[\"'])"
        },
        {
          "name": "storage.type.lunar",
          "match": "\\b(local|const|function)\\b|\\bconstructor\\b(?=\\s*\\()|\\b(get|set)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*\\()"
        },
        {
          "name": "storage.modifier.lunar",
          "match": "\\b(public|private|protected|readonly|static|abstract|async)\\b(?=\\s+[A-Za-z_])|\\b(extends|implements)\\b(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.operator.word.lunar",
          "match": "\\b(and|or|not)\\b|\\b(as|is|keyof|typeof)\\b(?=\\s+[A-Za-z_({\"'])|\\bawait\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lunar",
          "match": "\\b(number|string|boolean|any|void|never|unknown|table)\\b"
        },
        {
          "match": ":\\s*([A-Z][A-Za-z0-9_]*)(?!\\s*[({\"'])",
          "captures": {
            "1": {
              "name": "entity.name.type.lunar"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.lunar",
          "match": "\\b(assert|error|getmetatable|ipairs|load|loadfile|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|tonumber|tostring|type|xpcall|warn)\\b(?=\\s*\\()"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.lunar"
            }
          }
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.lunar",
      "match": "\\?\\?=|\\.\\.=|\\?\\?|\\?\\.\\[|\\?\\.|\\?\\[|\\|>|=>|->|//|<<|>>|\\.\\.\\.|\\.\\.|==|~=|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/%^#&|~<>=!?]"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lunar",
          "match": "\\b(nil|true|false)\\b"
        },
        {
          "name": "variable.language.self.lunar",
          "match": "\\bself\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "(::)([A-Za-z_][A-Za-z0-9_]*)(::)",
          "captures": {
            "1": {
              "name": "punctuation.definition.label.lunar"
            },
            "2": {
              "name": "entity.name.label.lunar"
            },
            "3": {
              "name": "punctuation.definition.label.lunar"
            }
          }
        },
        {
          "match": "\\b(goto)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.goto.lunar"
            },
            "2": {
              "name": "entity.name.label.lunar"
            }
          }
        }
      ]
    },
    "attributes": {
      "match": "(<)\\s*(const|close)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.lunar"
        },
        "2": {
          "name": "storage.modifier.attribute.lunar"
        },
        "3": {
          "name": "punctuation.definition.attribute.lunar"
        }
      }
    },
    "members": {
      "patterns": [
        {
          "match": "(?<![.:])([.:])([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[({\"'`])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.lunar"
            },
            "2": {
              "name": "entity.name.function.member.lunar"
            }
          }
        },
        {
          "match": "(?<!\\.)(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.lunar"
            },
            "2": {
              "name": "variable.other.property.lunar"
            }
          }
        }
      ]
    },
    "locals": {
      "match": "\\b(local)\\s+(?!function\\b)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.lunar"
        },
        "2": {
          "name": "variable.other.local.lunar"
        }
      }
    }
  }
}
