-- Lua 5.3 and 5.4 Core Global Functions
-- This file provides type declarations for Lua's built-in global functions
-- Automatically loaded with any Lunar project

-- Basic Functions
declare function print(...args: any): void end
declare function type(value: any): string end
declare function tonumber(value: any, base?: number): any end
declare function tostring(value: any): string end
declare function error(message?: any, level?: number): void end
declare function assert(condition: any, message?: any, ...rest: any): any end
declare function pcall(func: any, ...args: any): (boolean, any) end
declare function xpcall(func: any, errorHandler: any, ...args: any): (boolean, any) end

-- Type Conversion
declare function pairs(t: any): any end
declare function ipairs(t: any): any end
declare function next(t: any, key?: any): any end

-- Loading and Execution
declare function load(chunk: any, chunkname?: string, mode?: string, env?: any): any end
declare function loadfile(filename?: string, mode?: string, env?: any): any end
declare function dofile(filename?: string): any end
declare function require(modulename: string): any end

-- Metatables
declare function getmetatable(object: any): any end
declare function setmetatable(t: any, metatable: any): any end
declare function rawget(t: any, key: any): any end
declare function rawset(t: any, key: any, value: any): any end
declare function rawequal(v1: any, v2: any): boolean end
declare function rawlen(v: any): number
declare function collectgarbage(opt?: string, ...args: any): any

-- Collection Operations
declare function select(index: any, ...args: any): any end

-- Global Environment
declare const _G: any
-- The environment globals are looked up in (Lua 5.2+); a chunk may replace it.
declare local _ENV: any
declare const _VERSION: string
