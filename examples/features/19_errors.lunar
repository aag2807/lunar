-- Error handling with pcall/error
function risky(n: number): number
    if n < 0 then
        error("negative input")
    end
    return n * 2
end

local ok: boolean, result: any = pcall(risky, 5)
print(ok, result)

local failed: boolean, err: any = pcall(risky, -1)
print(failed, err)

-- Checked results: a wrong answer fails the run, not just a crash.
assert(ok == true and result == 10)
assert(failed == false)
assert(string.find(err, "negative input", 1, true) ~= nil)
