# Compiled binaries (in root only)
/lunar
/lunar2decl
/lunar-lsp

# Generated Lua files (keep source .lunar files only)
*.lua
!examples/*.lua.example
!examples/nvim-lsp-config.lua
!editors/**/*.lua
!vendor/**/*.lua

# Test files (root directory only)
/*test*.lunar
/simple.lunar
/debug.lunar
/func*.lunar

# Analysis and temporary documentation
/*_analysis.md
/type_*.lunar
/*_demo.lunar

# Generated documentation
/docs/

# Lunar cache directory (incremental compilation)
.lunar-cache/
.claude/
dist/
