-- Lua 5.3 and 5.4 string library

declare interface StringLib
	-- Binary packing (Lua 5.3+)
	pack: function(fmt: string, ...values: any): string
	packsize: function(fmt: string): number
	unpack: function(fmt: string, s: string, pos?: number): any
	dump: function(f: any, strip?: boolean): string

	-- String Searching
	-- find and match give the captures too; gsub's replacement is a
	-- string, a table or a function of the captures.
	find: function(s: string, pattern: string, init?: number, plain?: boolean): any
	match: function(s: string, pattern: string, init?: number): any
	gmatch: function(s: string, pattern: string, init?: number): function(): any
	gsub: function(s: string, pattern: string, repl: any, n?: number): (string, number)

	-- String Manipulation
	sub: function(s: string, i: number, j?: number): string
	upper: function(s: string): string
	lower: function(s: string): string
	reverse: function(s: string): string
	rep: function(s: string, n: number, sep?: string): string

	-- String Formatting
	format: function(formatstring: string, ...: any): string
	byte: function(s: string, i?: number, j?: number): any
	char: function(...: number): string

	-- String Length
	len: function(s: string): number
end

declare const string: StringLib
