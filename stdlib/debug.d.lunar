-- Lua 5.3 and 5.4 debug library
-- https://www.lua.org/manual/5.4/manual.html#6.10
-- Most functions take an optional thread first, so their arguments are
-- declared as a list.

declare interface Debug
	debug: function(): void
	gethook: function(thread?: any): any
	getinfo: function(...args: any): any
	getlocal: function(...args: any): any
	getmetatable: function(value: any): any
	getregistry: function(): any
	getupvalue: function(f: any, up: number): any
	getuservalue: function(u: any, n?: number): any
	sethook: function(...args: any): void
	setlocal: function(...args: any): any
	setmetatable: function(value: any, meta: any): any
	setupvalue: function(f: any, up: number, value: any): any
	setuservalue: function(udata: any, value: any, n?: number): any
	traceback: function(...args: any): any
	upvalueid: function(f: any, n: number): any
	upvaluejoin: function(f1: any, n1: number, f2: any, n2: number): void
end

declare const debug: Debug
