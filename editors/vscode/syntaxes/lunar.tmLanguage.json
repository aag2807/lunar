{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lunar",
  "scopeName": "source.lunar",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lunar",
          "begin": "--\\[\\[",
          "end": "\\]\\]"
        },
        {
          "name": "comment.line.double-dash.lunar",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lunar",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lunar",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.lunar",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lunar",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.multiline.lunar",
          "begin": "\\[\\[",
          "end": "\\]\\]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lunar",
          "match": "0[xX][0-9a-fA-F]+"
        },
        {
          "name": "constant.numeric.float.lunar",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lunar",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lunar",
          "match": "\\b(if|then|else|elseif|end|for|while|do|repeat|until|break|return|in)\\b"
        },
        {
          "name": "keyword.other.lunar",
          "match": "\\b(local|function|class|interface|enum|extends|implements|export|import|from|type|declare|namespace)\\b"
        },
        {
          "name": "storage.modifier.lunar",
          "match": "\\b(public|private|protected|readonly|static|abstract|override|const)\\b"
        },
        {
          "name": "constant.language.lunar",
          "match": "\\b(true|false|nil|self|super)\\b"
        },
        {
          "name": "keyword.operator.lunar",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lunar",
          "match": "\\b(number|string|boolean|nil|void|any|never|unknown)\\b"
        },
        {
          "name": "entity.name.type.lunar",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lunar",
          "match": "\\+|-|\\*|/|%|\\^|#|==|~=|<=|>=|<|>|=|\\.\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lunar",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.lunar",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
