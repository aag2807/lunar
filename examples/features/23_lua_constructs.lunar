-- Core Lua constructs a superset must accept
local t = {a = 1, b = 2}
for k, v in pairs(t) do
    print(k, v)
end

local i: number = 0
repeat
    i = i + 1
until i >= 3
print("repeat done", i)

local s = "x"
s = s .. "y"
print(s)

local nested = {list = {1, 2, 3}}
print(nested.list[2])

local function localFn(n: number): number
    return n + 1
end
print(localFn(1))

-- Conditions test truthiness, as in Lua: game loops are `while true do`.
local spins: number = 0
while true do
    spins = spins + 1
    if spins == 3 then
        break
    end
end

local maybe: number? = nil
local seen: string = "none"
if maybe then
    seen = "some " .. tostring(maybe + 1)
end

-- Checked results: a wrong answer fails the run, not just a crash.
assert(t.a == 1 and t.b == 2)
assert(i == 3)
assert(s == "xy")
assert(nested.list[2] == 2)
assert(localFn(1) == 2)
assert(spins == 3)
assert(seen == "none")
