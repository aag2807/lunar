-- A decorator on an exported class or function: the name holds what the
-- decorator returns, and that is what the module exports.
-- InstanceOf<T>: the decorator returns an instance of the class it is
-- given, so WorldState holds one, checked as an instance.
local function singleton<T>(cls: T): InstanceOf<T>
    return (cls as any).new()
end

@singleton
export class WorldState
    tick: number = 0

    advance(): void
        self.tick = self.tick + 1
    end
end

local calls = 0
local function counted(f: any): any
    return function(...: any): any
        calls = calls + 1
        return f(...)
    end
end

@counted
export function double(n: number): number
    return n * 2
end

WorldState:advance()
local tick: number = WorldState.tick
assert(tick == 1 and getmetatable(WorldState).advance ~= nil)
assert(double(4) == 8 and calls == 1)
