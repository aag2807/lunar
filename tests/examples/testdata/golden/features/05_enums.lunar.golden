local Color = {
    Red = 0,
    Green = 1,
    Blue = 2,
}

local Status = {
    Active = 1,
    Inactive = 0,
}

local Rank = {
    Grunt = 0,
    Elite = 10,
    Boss = 11,
}

function colorName(c)
    if c == Color.Red then
        return "red"
    end
    if c == Color.Green then
        return "green"
    end
    return "blue"
end

print(colorName(Color.Red))

print(colorName(Color.Blue))

print(Status.Active, Status.Inactive)

assert(colorName(Color.Red) == "red")

assert(colorName(Color.Green) == "green")

assert(colorName(Color.Blue) == "blue")

assert(Status.Active == 1 and Status.Inactive == 0)

assert(Rank.Grunt == 0 and Rank.Elite == 10 and Rank.Boss == 11)
