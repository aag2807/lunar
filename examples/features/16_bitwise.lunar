-- Bitwise operators
local a: number = 12
local b: number = 10

print(a & b)
print(a | b)
print(a ~ b)
print(a << 2)
print(a >> 2)

-- Checked results: a wrong answer fails the run, not just a crash.
assert((a & b) == 8)
assert((a | b) == 14)
assert((a ~ b) == 6)
assert((a << 2) == 48)
assert((a >> 2) == 3)
