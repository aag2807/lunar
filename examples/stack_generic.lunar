-- Full generic Stack implementation from spec

class Stack<T>
    private items: number

    constructor()
        self.items = 0
    end

    public push(item: T): void
        self.items = self.items + 1
    end

    public size(): number
        return self.items
    end
end

-- Generic function example - transforms T to U using a mapper function
function map<T, U>(item: T, mapper: (val: T) => U): U
    return mapper(item)
end

-- Example usage with a simple transformation
local numberToString: (n: number) => string = function(n: number): string
    return tostring(n)
end

local result: string = map<number, string>(42, numberToString)
