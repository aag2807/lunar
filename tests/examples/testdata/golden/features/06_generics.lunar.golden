local Box, Pair

function identity(value)
    return value
end

function firstOf(items)
    return items[1]
end

Box = {}
Box.__index = Box

function Box.__init(self, value)
    self.value = value
end
function Box.new(...)
    local self = setmetatable({}, Box)
    Box.__init(self, ...)
    return self
end

function Box:get()
    return self.value
end


Pair = {}
Pair.__index = Pair

function Pair.__init(self, left, right)
    self.left = left
    self.right = right
end
function Pair.new(...)
    local self = setmetatable({}, Pair)
    Pair.__init(self, ...)
    return self
end

function Pair:first()
    return self.left
end

function Pair:second()
    return self.right
end


print(identity(42))

print(identity("text"))

print(firstOf({7, 8, 9}))

local b = Box.new("boxed")

print(b:get())

local p = Pair.new("age", 30)

print(p:first(), p:second())

assert(identity(42) == 42 and identity("text") == "text")

assert(firstOf({7, 8, 9}) == 7)

assert(b:get() == "boxed")

assert(p:first() == "age" and p:second() == 30)
