local Geometry, Game

Geometry = {}
do
    local area
    function area(w, h)
        return w * h
    end
    Geometry.area = area
end

Game = {}
do
    local Orc
    Orc = {}
    Orc.__index = Orc

    function Orc.__init(self, hp)
        self.hp = hp
    end
    function Orc.new(...)
        local self = setmetatable({}, Orc)
        Orc.__init(self, ...)
        return self
    end

    function Orc:hit(n)
        self.hp = self.hp - n
        return self.hp
    end

    Game.Orc = Orc
end

local orc = Game.Orc.new(5)

print(Geometry.area(3, 4))

assert(Geometry.area(3, 4) == 12)

assert(orc:hit(2) == 3 and Game.Orc.new(1):hit(1) == 0)
