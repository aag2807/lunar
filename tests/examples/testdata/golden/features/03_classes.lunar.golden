local Animal, Dog, Puppy

Animal = {}
Animal.__index = Animal

function Animal.__init(self, name, legs)
    self.name = name
    self.legs = legs
end
function Animal.new(...)
    local self = setmetatable({}, Animal)
    Animal.__init(self, ...)
    return self
end

function Animal:describe()
    return self.name .. " has " .. tostring(self.legs) .. " legs"
end

function Animal:speak()
    return "..."
end

function Animal.kingdom()
    return "Animalia"
end


Dog = {}
setmetatable(Dog, {__index = Animal})
Dog.__index = Dog

function Dog.__init(self, name)
    Animal.__init(self, name, 4)
end
function Dog.new(...)
    local self = setmetatable({}, Dog)
    Dog.__init(self, ...)
    return self
end

function Dog:speak()
    return "Woof"
end

if Animal.__getters ~= nil then
    Dog.__getters = setmetatable({}, {__index = Animal.__getters})
    Dog.__setters = setmetatable({}, {__index = Animal.__setters})
    Dog.__index = function(self, key)
        local get = Dog.__getters[key]
        if get ~= nil then
            return get(self)
        end
        return Dog[key]
    end
    Dog.__newindex = function(self, key, value)
        local set = Dog.__setters[key]
        if set ~= nil then
            set(self, value)
            return
        end
        rawset(self, key, value)
    end
end


local a = Animal.new("generic", 2)

local d = Dog.new("Rex")

print(a:describe())

print(d:describe())

print(a:speak(), d:speak())

print(Animal.kingdom())

Puppy = {}
setmetatable(Puppy, {__index = Dog})
Puppy.__index = Puppy

function Puppy.__init(self, ...)
    Dog.__init(self, ...)
end
function Puppy.new(...)
    local self = setmetatable({}, Puppy)
    Puppy.__init(self, ...)
    return self
end

function Puppy:speak()
    return "Yip"
end

if Dog.__getters ~= nil then
    Puppy.__getters = setmetatable({}, {__index = Dog.__getters})
    Puppy.__setters = setmetatable({}, {__index = Dog.__setters})
    Puppy.__index = function(self, key)
        local get = Puppy.__getters[key]
        if get ~= nil then
            return get(self)
        end
        return Puppy[key]
    end
    Puppy.__newindex = function(self, key, value)
        local set = Puppy.__setters[key]
        if set ~= nil then
            set(self, value)
            return
        end
        rawset(self, key, value)
    end
end


local pup = Puppy.new("Bolt")

assert(a:describe() == "generic has 2 legs")

assert(d:describe() == "Rex has 4 legs")

assert(a:speak() == "..." and d:speak() == "Woof")

assert(Animal.kingdom() == "Animalia")

assert(pup:describe() == "Bolt has 4 legs" and pup:speak() == "Yip")
