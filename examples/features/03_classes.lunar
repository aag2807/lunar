-- Classes: fields, visibility, methods, statics, inheritance, super
class Animal
    protected name: string
    private legs: number

    constructor(name: string, legs: number)
        self.name = name
        self.legs = legs
    end

    describe(): string
        return self.name .. " has " .. tostring(self.legs) .. " legs"
    end

    speak(): string
        return "..."
    end

    static kingdom(): string
        return "Animalia"
    end
end

class Dog extends Animal
    constructor(name: string)
        super(name, 4)
    end

    speak(): string
        return "Woof"
    end
end

local a: Animal = Animal("generic", 2)
local d: Dog = Dog("Rex")

print(a.describe())
print(d.describe())
print(a.speak(), d.speak())
print(Animal.kingdom())

-- A subclass without a constructor of its own inherits its parent's.
class Puppy extends Dog
    speak(): string
        return "Yip"
    end
end

local pup: Puppy = Puppy("Bolt")

-- Checked results: a wrong answer fails the run, not just a crash.
assert(a.describe() == "generic has 2 legs")
assert(d.describe() == "Rex has 4 legs")
assert(a.speak() == "..." and d.speak() == "Woof")
assert(Animal.kingdom() == "Animalia")
assert(pup.describe() == "Bolt has 4 legs" and pup.speak() == "Yip")
