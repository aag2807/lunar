-- Lua 5.1 Debug Library Type Declarations
-- This file provides type definitions for Lua's debug/introspection functions

-- Debug module interface
declare interface Debug
    -- Enters interactive mode
    debug: function(): void

    -- Returns the environment of object o
    getfenv: function(o: any): any

    -- Returns the current hook settings
    gethook: function(): any

    -- Returns a table with information about a function
    getinfo: function(f: any, what: string): any

    -- Returns the name and value of a local variable
    getlocal: function(level: number, local_index: number): any

    -- Returns the metatable of the given object
    getmetatable: function(object: any): any

    -- Returns the registry table
    getregistry: function(): any

    -- Returns the name and value of an upvalue
    getupvalue: function(func: any, up: number): any

    -- Sets the environment of the given object
    setfenv: function(object: any, env: any): any

    -- Sets the given function as a hook
    sethook: function(hook: any, mask: string, count: number): void

    -- Assigns a value to a local variable
    setlocal: function(level: number, local_index: number, value: any): string

    -- Sets the metatable for the given object
    setmetatable: function(object: any, meta: any): any

    -- Assigns a value to an upvalue
    setupvalue: function(func: any, up: number, value: any): string

    -- Returns a string with a traceback of the call stack
    traceback: function(...args: any): string
end

-- Global debug table
declare const debug: Debug
