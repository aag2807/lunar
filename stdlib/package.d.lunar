-- Lua 5.3 and 5.4 package library
-- https://www.lua.org/manual/5.4/manual.html#6.3

declare interface Package
	config: string
	cpath: string
	loaded: any
	loadlib: function(libname: string, funcname: string): any
	path: string
	preload: any
	searchers: any
	searchpath: function(name: string, path: string, sep?: string, rep?: string): any
end

declare const package: Package
