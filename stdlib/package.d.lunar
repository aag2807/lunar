-- Lua 5.1 Package/Module Library Type Declarations
-- This file provides type definitions for Lua's module loading and package management

-- Package module interface
declare interface Package
    -- The path used by require to search for Lua loaders
    path: string

    -- The path used by require to search for C loaders
    cpath: string

    -- A table of loaded modules
    loaded: any

    -- A table of preloaded modules
    preload: any

    -- A table of loader functions
    loaders: any

    -- Sets a metatable for module with __index pointing to global environment
    seeall: function(module: any): void
end

-- Global package table
declare const package: Package

-- Creates a module (already declared in lua.d.lunar, keeping for reference)
-- declare function module(name: string, ...args: any): void end
