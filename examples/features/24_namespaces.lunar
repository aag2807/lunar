namespace Geometry
    export function area(w: number, h: number): number
        return w * h
    end
end

-- A class exported from a namespace constructs and takes self as usual.
namespace Game
    export class Orc
        hp: number
        constructor(hp: number)
            self.hp = hp
        end
        hit(n: number): number
            self.hp = self.hp - n
            return self.hp
        end
    end
end

local orc = Game.Orc(5)

print(Geometry.area(3, 4))

-- Checked results: a wrong answer fails the run, not just a crash.
assert(Geometry.area(3, 4) == 12)
assert(orc.hit(2) == 3 and Game.Orc.new(1).hit(1) == 0)
