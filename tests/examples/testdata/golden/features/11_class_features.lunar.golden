local Account, Point, Savings, Plain

Account = {}
Account.__index = Account
Account.__getters = {}
Account.__setters = {}

function Account.__init(self, id, balance)
    self.id = id
    self.balance = balance
end
function Account.new(...)
    local self = setmetatable({}, Account)
    Account.__init(self, ...)
    return self
end

Account.count = 0

function Account.__getters.amount(self)
    return self.balance
end

function Account.__setters.amount(self, value)
    self.balance = value
end

Account.__index = function(self, key)
    local get = Account.__getters[key]
    if get ~= nil then
        return get(self)
    end
    return Account[key]
end
Account.__newindex = function(self, key, value)
    local set = Account.__setters[key]
    if set ~= nil then
        set(self, value)
        return
    end
    rawset(self, key, value)
end


Point = {}
Point.__index = Point

function Point.__init(self, x, y)
    self.x = x
    self.y = y
end
function Point.new(...)
    local self = setmetatable({}, Point)
    Point.__init(self, ...)
    return self
end

function Point:sum()
    return self.x + self.y
end


local acct = Account.new("a-1", 100)

print(acct.id)

local p = Point.new(2, 3)

print(p.x, p.y, p:sum())

Savings = {}
setmetatable(Savings, {__index = Account})
Savings.__index = Savings
Savings.__getters = setmetatable({}, {__index = Account.__getters})
Savings.__setters = setmetatable({}, {__index = Account.__setters})

function Savings.__init(self, id, balance, rate)
    Account.__init(self, id, balance)
    self.rate = rate
end
function Savings.new(...)
    local self = setmetatable({}, Savings)
    Savings.__init(self, ...)
    return self
end

function Savings.__getters.interest(self)
    return self.amount * self.rate
end

Savings.__index = function(self, key)
    local get = Savings.__getters[key]
    if get ~= nil then
        return get(self)
    end
    return Savings[key]
end
Savings.__newindex = function(self, key, value)
    local set = Savings.__setters[key]
    if set ~= nil then
        set(self, value)
        return
    end
    rawset(self, key, value)
end


Plain = {}
setmetatable(Plain, {__index = Account})
Plain.__index = Plain

function Plain.__init(self, id)
    Account.__init(self, id, 1)
end
function Plain.new(...)
    local self = setmetatable({}, Plain)
    Plain.__init(self, ...)
    return self
end

if Account.__getters ~= nil then
    Plain.__getters = setmetatable({}, {__index = Account.__getters})
    Plain.__setters = setmetatable({}, {__index = Account.__setters})
    Plain.__index = function(self, key)
        local get = Plain.__getters[key]
        if get ~= nil then
            return get(self)
        end
        return Plain[key]
    end
    Plain.__newindex = function(self, key, value)
        local set = Plain.__setters[key]
        if set ~= nil then
            set(self, value)
            return
        end
        rawset(self, key, value)
    end
end


local savings = Savings.new("s-1", 100, 0.5)

local plain = Plain.new("p-1")

assert(acct.id == "a-1")

assert(Account.count == 0)

assert(p.x == 2 and p.y == 3 and p:sum() == 5)

assert(acct.amount == 100)

acct.amount = 250

assert(acct.amount == 250)

assert(savings.amount == 100 and savings.interest == 50)

savings.amount = 10

assert(savings.amount == 10 and savings.interest == 5)

assert(plain.amount == 1)
