local Guard

local inspector = {}

local function show(name, info, options)
    table.insert(inspector, {name = name, type = info.type or "any", default = info.default, group = options.group or "General", choices = info.choices, tooltip = info.doc})
end

local function export(owner, name, info)
    show(name, info, {})
end

local function exportWith(options)
    return function(owner, name, info)
        show(name, info, options)
    end
end

Guard = {}
Guard.__index = Guard

function Guard.__init(self)
    self.speed = 2.0
    self.kind = "brute"
    self.health = 5
    self.alertness = 0
end
function Guard.new(...)
    local self = setmetatable({}, Guard)
    Guard.__init(self, ...)
    return self
end

export(Guard, "speed", { type = "number", default = 2.0, has_default = true, line = 60, file = "26_field_decorators.lunar" })
export(Guard, "kind", { type = "\"sentry\" | \"brute\" | \"warden\"", default = "brute", has_default = true, choices = { "sentry", "brute", "warden" }, line = 64, file = "26_field_decorators.lunar", doc = "How it fights; the inspector shows a drop-down of the three." })
exportWith({min = 0, max = 50, group = "Combat"})(Guard, "health", { type = "number", default = 5, has_default = true, line = 67, file = "26_field_decorators.lunar" })


for _, field in ipairs(inspector) do
    print(field.group, field.name, field.type, field.default)
end

local a, b = Guard.new(), Guard.new()

assert(# inspector == 3)

assert(inspector[1].name == "speed" and inspector[1].type == "number" and inspector[1].default == 2.0)

assert(inspector[2].name == "kind" and inspector[2].default == "brute" and # inspector[2].choices == 3)

assert(inspector[2].tooltip == "How it fights; the inspector shows a drop-down of the three.")

assert(inspector[3].name == "health" and inspector[3].group == "Combat")

assert(a.health == 5 and b.kind == "brute")
