local Stack = {}
Stack.__index = Stack

function Stack.new()
    local self = setmetatable({}, Stack)
    self.items = 0
    return self
end

function Stack:push(item)
    self.items = self.items + 1
end

function Stack:size()
    return self.items
end


function map(item, mapper)
    return mapper(item)
end

local numberToString = function(n)
    return tostring(n)
end

local result = map(42, numberToString)
