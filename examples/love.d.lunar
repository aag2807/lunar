-- LÖVE 2D Framework Type Declarations
-- This file provides type information for the LÖVE 2D game framework
-- Place this file in your project to get type checking for LÖVE APIs

-- Color type helper
declare type Color
	r: number
	g: number
	b: number
	a: number
end

-- Graphics module
declare interface GraphicsModule
	-- Drawing functions (static - called with love.graphics.methodName)
	static clear(r: number, g: number, b: number, a: number): void
	static print(text: string, x: number, y: number): void
	static rectangle(mode: string, x: number, y: number, width: number, height: number): void
	static circle(mode: string, x: number, y: number, radius: number): void
	static line(x1: number, y1: number, x2: number, y2: number): void

	-- State functions
	static setColor(r: number, g: number, b: number, a: number): void
	static setBackgroundColor(r: number, g: number, b: number): void

	-- Coordinate system
	static translate(dx: number, dy: number): void
	static rotate(angle: number): void
	static scale(sx: number, sy: number): void
	static push(): void
	static pop(): void
end

-- Window module
declare interface WindowModule
	static setTitle(title: string): void
	static setMode(width: number, height: number): boolean
	static getWidth(): number
	static getHeight(): number
	static setFullscreen(fullscreen: boolean): boolean
end

-- Keyboard module
declare interface KeyboardModule
	static isDown(key: string): boolean
	static setKeyRepeat(enable: boolean): void
end

-- Mouse module
declare interface MouseModule
	static getX(): number
	static getY(): number
	static getPosition(): number
	static isDown(button: number): boolean
	static setVisible(visible: boolean): void
end

-- Timer module
declare interface TimerModule
	static getDelta(): number
	static getFPS(): number
	static getTime(): number
	static sleep(seconds: number): void
end

-- Audio module
declare interface AudioModule
	static newSource(filename: string, sourceType: string): any
	static play(source: any): void
	static pause(source: any): void
	static stop(source: any): void
	static setVolume(volume: number): void
end

-- Main LÖVE interface
declare interface Love
	-- Module properties (accessed with love.moduleName)
	graphics: GraphicsModule
	window: WindowModule
	keyboard: KeyboardModule
	mouse: MouseModule
	timer: TimerModule
	audio: AudioModule

	-- Callback methods (called with love:methodName)
	load(): void
	update(dt: number): void
	draw(): void
	keypressed(key: string): void
	keyreleased(key: string): void
	mousepressed(x: number, y: number, button: number): void
	mousereleased(x: number, y: number, button: number): void
end

-- Global love object
declare const love: Love
