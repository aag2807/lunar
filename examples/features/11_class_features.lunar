-- Readonly, static props, getters/setters, constructor parameter properties
class Account
    readonly id: string
    static count: number = 0
    private balance: number

    constructor(id: string, balance: number)
        self.id = id
        self.balance = balance
    end

    get amount(): number
        return self.balance
    end

    set amount(value: number)
        self.balance = value
    end
end

class Point
    constructor(public x: number, public y: number)
    end

    sum(): number
        return self.x + self.y
    end
end

local acct: Account = Account("a-1", 100)
print(acct.id)

local p: Point = Point(2, 3)
print(p.x, p.y, p.sum())
