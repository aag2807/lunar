-- A declared generic function's results have the type it is given.
interface Node
    name: string
end

interface Enemy extends Node
    hp: number
end

declare function children<T>(parent: Node, kind: string): T[]

local root: Node = { name = "root" }
local enemies = children<Enemy>(root, "enemy")
local label: string = enemies[1].hp
-- error: Cannot assign type 'number' to variable 'label' of type 'string'

declare function pick<K, V>(map: table<K, V>, key: K): V
local name: string = pick({ imps = 4 }, "imps")
-- error: Cannot assign type 'number' to variable 'name' of type 'string'
