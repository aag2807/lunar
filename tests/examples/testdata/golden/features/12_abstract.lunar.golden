local Vehicle = {}
Vehicle.__index = Vehicle

function Vehicle.new(wheels)
    local self = setmetatable({}, Vehicle)
    self.wheels = nil
    self.wheels = wheels
    return self
end

function Vehicle:describe()
    return tostring(self.wheels) .. " wheels, says " .. self:sound()
end


local Car = {}
setmetatable(Car, {__index = Vehicle})
Car.__index = Car

function Car.new()
    local self = setmetatable({}, Car)
    do local __parent = Vehicle.new(4); for __k, __v in pairs(__parent) do self[__k] = __v end end
    return self
end

function Car:sound()
    return "vroom"
end

if Vehicle.__getters ~= nil then
    Car.__getters = setmetatable({}, {__index = Vehicle.__getters})
    Car.__setters = setmetatable({}, {__index = Vehicle.__setters})
    Car.__index = function(self, key)
        local get = Car.__getters[key]
        if get ~= nil then
            return get(self)
        end
        return Car[key]
    end
    Car.__newindex = function(self, key, value)
        local set = Car.__setters[key]
        if set ~= nil then
            set(self, value)
            return
        end
        rawset(self, key, value)
    end
end


local c = Car.new()

print(c:describe())

assert(c:describe() == "4 wheels, says vroom")
