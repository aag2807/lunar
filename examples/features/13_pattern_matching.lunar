-- Pattern matching with literals, guards, structs, wildcards
type Shape = any

function area(s: Shape): number
    return match s with
        | { kind: "circle", radius: r } -> 3.14159 * r * r
        | { kind: "rect", w: w, h: h } -> w * h
        | _ -> 0
    end
end

function grade(score: number): string
    return match score with
        | 100 -> "perfect"
        | s when s >= 90 -> "A"
        | s when s >= 80 -> "B"
        | s when s >= 70 -> "C"
        | _ -> "F"
    end
end

print(area({kind = "circle", radius = 2}))
print(area({kind = "rect", w = 3, h = 4}))
print(area({kind = "unknown"}))
print(grade(100), grade(95), grade(85), grade(50))

-- Checked results: a wrong answer fails the run, not just a crash.
assert(math.abs(area({kind = "circle", radius = 2}) - 12.56636) < 1e-9)
assert(area({kind = "rect", w = 3, h = 4}) == 12)
assert(area({kind = "unknown"}) == 0)
assert(grade(100) == "perfect" and grade(95) == "A" and grade(85) == "B")
assert(grade(75) == "C" and grade(50) == "F")
