-- Lua 5.3 and 5.4 table library

declare interface TableLib
	-- Table Modification
	-- insert(t, value) or insert(t, pos, value)
	insert: function(t: any, pos: any, value?: any): void
	remove: function(t: any, pos?: number): any
	concat: function(t: any, sep?: string, i?: number, j?: number): string

	-- Table Sorting
	sort: function(t: any, comp?: function(a: any, b: any): boolean): void

	-- table.pack(...) holds its arguments and their count in n
	pack: function(...args: any): any
	unpack: function(t: any, i?: number, j?: number): any
	move: function(a1: any, f: number, e: number, t: number, a2?: any): any
end

declare const table: TableLib
