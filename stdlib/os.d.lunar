-- Lua 5.3 and 5.4 operating system library
-- https://www.lua.org/manual/5.4/manual.html#6.9

-- What os.time takes: year, month and day are required, the rest default.
-- os.date("*t") gives every field.
declare type DateTable
	year: number
	month: number
	day: number
	hour?: number
	min?: number
	sec?: number
	wday?: number
	yday?: number
	isdst?: boolean
end

declare interface OSLib
	clock: function(): number
	-- A string, or a table for the formats "*t" and "!*t".
	date: function(format?: string, time?: number): any
	difftime: function(t2: number, t1?: number): number
	execute: function(command?: string): any
	exit: function(code?: boolean | number, close?: boolean): void
	getenv: function(varname: string): string | nil
	remove: function(filename: string): any
	rename: function(oldname: string, newname: string): any
	setlocale: function(locale?: string, category?: string): string | nil
	time: function(table?: DateTable): number
	tmpname: function(): string
end

declare const os: OSLib
