-- Lua 5.3+ utf8 library
-- https://www.lua.org/manual/5.4/manual.html#6.5

declare interface Utf8Lib
    char: function(...codepoints: number): string
    charpattern: string
    codes: function(s: string, lax?: boolean): any
    codepoint: function(s: string, i?: number, j?: number, lax?: boolean): any
    -- The length, or nil and the position of the first invalid byte.
    len: function(s: string, i?: number, j?: number, lax?: boolean): any
    offset: function(s: string, n: number, i?: number): number
end

declare const utf8: Utf8Lib
