-- Interfaces: methods, properties, extends, implements
interface Shape
    area(): number
    name(): string
end

interface Named
    label: string
end

class Circle implements Shape
    private radius: number

    constructor(radius: number)
        self.radius = radius
    end

    area(): number
        return 3.14159 * self.radius * self.radius
    end

    name(): string
        return "circle"
    end
end

class Square implements Shape
    private side: number

    constructor(side: number)
        self.side = side
    end

    area(): number
        return self.side * self.side
    end

    name(): string
        return "square"
    end
end

function report(s: Shape): string
    return s.name() .. ": " .. tostring(s.area())
end

print(report(Circle(1)))
print(report(Square(3)))

-- Optional fields may be left out of a literal: the duel phase has no speed.
interface Phase
    name: string
    speed: number?
    delay?: number
end

local duel: Phase = { name = "duel" }
local chase: Phase = { name = "chase", speed = 3 }

-- Checked results: a wrong answer fails the run, not just a crash.
assert(report(Circle(1)) == "circle: 3.14159")
assert(report(Square(3)) == "square: 9")
assert(duel.speed == nil and duel.delay == nil)
assert(chase.speed == 3)
