-- Generic functions and classes
function identity<T>(value: T): T
    return value
end

function firstOf<T>(items: T[]): T
    return items[1]
end

class Box<T>
    private value: T

    constructor(value: T)
        self.value = value
    end

    get(): T
        return self.value
    end
end

class Pair<A, B>
    private left: A
    private right: B

    constructor(left: A, right: B)
        self.left = left
        self.right = right
    end

    first(): A
        return self.left
    end

    second(): B
        return self.right
    end
end

print(identity<number>(42))
print(identity<string>("text"))
print(firstOf<number>({7, 8, 9}))

local b: Box<string> = Box<string>("boxed")
print(b.get())

local p: Pair<string, number> = Pair<string, number>("age", 30)
print(p.first(), p.second())
