local Circle = {}
Circle.__index = Circle

function Circle.new(radius)
    local self = setmetatable({}, Circle)
    self.radius = nil
    self.radius = radius
    return self
end

function Circle:area()
    return 3.14159 * self.radius * self.radius
end

function Circle:name()
    return "circle"
end


local Square = {}
Square.__index = Square

function Square.new(side)
    local self = setmetatable({}, Square)
    self.side = nil
    self.side = side
    return self
end

function Square:area()
    return self.side * self.side
end

function Square:name()
    return "square"
end


function report(s)
    return s:name() .. ": " .. tostring(s:area())
end

print(report(Circle.new(1)))

print(report(Square.new(3)))

local duel = {name = "duel"}

local chase = {name = "chase", speed = 3}

local orc = {attack = function(self, target)
    return # target + # self.name
end, name = "orc", onHit = function(damage)
    return damage * 2
end}

local arrows = {count = 20, item = "arrow"}

local coins = {count = 3, item = 5}

assert(report(Circle.new(1)) == "circle: 3.14159")

assert(report(Square.new(3)) == "square: 9")

assert(duel.speed == nil and duel.delay == nil)

assert(chase.speed == 3)

assert(orc:attack("imp") == 6)

assert(orc.onHit(4) == 8)

assert(arrows.item == "arrow" and coins.item * coins.count == 15)
